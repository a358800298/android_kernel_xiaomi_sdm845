# =============================================================================
# docker.config - Docker / runc 容器支持配置片段
# 目标树: LineageOS/android_kernel_xiaomi_sdm845 (分支 lineage-21, CAF msm-4.9, sdm845 / dipper)
# 放置位置: arch/arm64/configs/docker.config
# 合并顺序: vendor/xiaomi/mi845_defconfig -> vendor/xiaomi/dipper.config -> docker.config
#           (越靠后优先级越高；官方树没有 lxc.config，它提供的那几项已并入第 8 节)
#
# 格式铁律（否则 merge_config.sh 会吐一堆假警告）:
#   1) 生效行必须是裸的 CONFIG_X=y / # CONFIG_X is not set，行尾不许跟注释。
#      merge_config.sh 末段是拿"片段原文整行"和"最终 .config 整行"做字符串比对，
#      行尾多一个 "# 说明" 就会被判定 not in final .config。
#   2) 注释掉的候选行不能写成 "# CONFIG_X=y"，要写 "#   CONFIG_X=y"（多缩进两格）。
#      因为它的正则能从 "# CONFIG_" 开头抽符号名，写成立刻变成一条"请求"。
#
# 设计原则:
#   1) 容器相关项一律 =y，绝不用 =m
#      (AK3 只替换 Image.gz-dtb，不打包 .ko；ROM 里的 .ko 与自编内核 vermagic 不符)
#   2) 只写本 4.9 树真实存在的符号
#   3) 不碰任何 Android 行为项 (不写 DEVTMPFS_MOUNT)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. 命名空间
#    runc 硬依赖；mi845_defconfig 里 UTS_NS/PID_NS 是显式关闭的
#    mount namespace 无独立符号，随 CONFIG_NAMESPACES 一起打开
# -----------------------------------------------------------------------------
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_NET_NS=y

# -----------------------------------------------------------------------------
# 2. cgroups v1 (4.9 只有 v1，Docker 用 cgroupfs driver 即可)
#    CGROUP_DEVICE / CGROUP_PIDS 在 lxc.config 里已经置 y，这里重复声明
#    只为自证 + 防上游哪天删了那两行
# -----------------------------------------------------------------------------
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_CPUSETS=y

# -----------------------------------------------------------------------------
# 3. seccomp — runc 默认 profile 依赖 SECCOMP_FILTER
# -----------------------------------------------------------------------------
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# -----------------------------------------------------------------------------
# 4. overlayfs / 文件系统
#    本树 fs/overlayfs/Kconfig 只有 OVERLAY_FS 一个选项
#    （无 OVERLAY_FS_REDIRECT_DIR / OVERLAY_FS_NFS_EXPORT，写了会被丢弃）
# -----------------------------------------------------------------------------
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_FUSE_FS=y

# -----------------------------------------------------------------------------
# 5. 容器网络: bridge / veth
#    BRIDGE_NETFILTER 是本次两个真缺口之一:
#    mi845_defconfig 里显式 "# CONFIG_BRIDGE_NETFILTER is not set"，lxc.config 没覆盖
# -----------------------------------------------------------------------------
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_VETH=y
CONFIG_MACVLAN=y
CONFIG_VLAN_8021Q=y
CONFIG_TUN=y
CONFIG_DUMMY=y

# -----------------------------------------------------------------------------
# 6. netfilter / iptables — docker 端口映射 + SNAT 出网
#    4.9 的 MASQUERADE 符号是 IP_NF_TARGET_MASQUERADE / IP6_NF_TARGET_MASQUERADE，
#    不是 NETFILTER_XT_TARGET_MASQUERADE (4.18+)；写错会被静默丢弃
# -----------------------------------------------------------------------------
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_IPV4=y
CONFIG_NF_CONNTRACK_IPV6=y
CONFIG_NF_NAT_IPV4=y
CONFIG_NF_NAT_IPV6=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y

# 第二个真缺口: 全树无人开，docker 的 DOCKER 链要用 -m addrtype
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y

CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_IPRANGE=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_MATCH_CONNLIMIT=y
CONFIG_NETFILTER_XT_MATCH_HL=y
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y

# -----------------------------------------------------------------------------
# 7. Android 侧必须项
#    ANDROID_PARANOID_NETWORK 必须为 n，否则容器内进程（UID 不在 AID_INET 组）无网络
#    FHANDLE 在 mi845_defconfig 里被显式关掉，这里翻回来
#    不动 DEVTMPFS_MOUNT：内核自动挂 /dev 会和 Android init 抢，卡第一屏
# -----------------------------------------------------------------------------
# CONFIG_ANDROID_PARANOID_NETWORK is not set
CONFIG_FHANDLE=y
CONFIG_DEVTMPFS=y
CONFIG_BINFMT_MISC=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# -----------------------------------------------------------------------------
# 8. 原本靠 lxc.config 提供的项，搬到这里让本片段能独立工作
#    官方 LineageOS 树没有 lxc.config（那是 awkoo 加的），用官方树编译时需要这几项
# -----------------------------------------------------------------------------
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_EVENTFD=y
CONFIG_EPOLL=y
CONFIG_UNIX_DIAG=y
CONFIG_INET_DIAG=y
CONFIG_PACKET_DIAG=y
CONFIG_NETLINK_DIAG=y

# =============================================================================
# 可选增强 —— 默认全部注释。取消注释时把 "#   " 改成 "# " 都没问题，
# 但要确保生效行是裸的 CONFIG_X=y（去掉注释符号即可）
# =============================================================================

# --- 更细的资源限制 ---
#   CONFIG_CGROUP_NET_CLS=y        tc classid 打标
#   CONFIG_BLK_CGROUP=y            --device-read-bps / --blkio-weight
#   CONFIG_CGROUP_HUGETLB=y        手机基本用不到
#   CONFIG_MEMCG_KMEM=y            内核内存记账，6GB 机型不建议开

# --- 高级网络模式 ---
#   CONFIG_IPVLAN=y                docker --network ipvlan
#   CONFIG_VXLAN=y                 overlay 网络 / swarm
#   CONFIG_IP_SET=y                ipset（ufw / fail2ban 大规模规则）
#   CONFIG_IP_SET_HASH_NET=y
#   CONFIG_NETFILTER_XT_SET=y
#   CONFIG_NETFILTER_XT_MATCH_RECENT=y
#   CONFIG_NETFILTER_XT_MATCH_STRING=y
#   CONFIG_NETFILTER_XT_TARGET_LOG=y
#   CONFIG_NETFILTER_XT_TARGET_NFLOG=y
#   CONFIG_NF_CT_NETLINK=y         conntrack -L / -E（4.9 的符号名，不是 NF_CONNTRACK_NETLINK）

# --- 兼容性 / 工具 ---
#   CONFIG_CHECKPOINT_RESTORE=y    lxc.config 已置 y，CRIU 用
#   CONFIG_KEYS=y                  keyctl 相关

# =============================================================================
# 禁止项（写在这里防止后人手滑）
#   CONFIG_DEVTMPFS_MOUNT=y        与 Android init 抢 /dev -> 卡第一屏
#   CONFIG_MEMCG_KMEM=y            除非你确定要背这个内存开销
#   CONFIG_CGROUP_DEBUG=y          只调参用，别进发布版
#   CONFIG_USER_NS_UNPRIVILEGED=y  4.9 无此符号
# =============================================================================
